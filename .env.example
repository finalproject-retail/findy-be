# docker-compose.yml 과 동일한 값으로 .env 파일을 만드세요.
# 로컬 IDE 실행 시에는 DB_HOST=localhost, REDIS_HOST=localhost 로 두면 됩니다.
# Docker Compose 실행 시 컨테이너 내부 호스트명(postgres, redis)은 compose가 자동 설정합니다.

# PostgreSQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Redis
REDIS_HOST=
REDIS_PORT=

# user-service
JWT_SECRET_KEY=
USER_SERVICE_PORT=

# apigateway
APIGATEWAY_PORT=
CORS_ALLOWED_ORIGINS=

# Kafka (apache/kafka in docker-compose)
# - Docker Compose로 앱 실행: compose가 KAFKA_BOOTSTRAP_SERVERS=kafka:9092 로 설정 (변경 불필요)
# - IDE/호스트에서 앱만 직접 실행: localhost:9094
KAFKA_PORT=9094
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# shopping-service (application.yaml server.port=8887)
SHOPPING_SERVICE_PORT=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
MFDS_API_KEY=
HACCP_SERVICE_KEY=
KCA_PRODUCT_PRICE_SERVICE_KEY=

# map-service (application.yaml server.port=8888)
MAP_SERVICE_PORT=

# recommendation-service
RECOMMENDATION_SERVICE_PORT=
OPENAI_API_KEY=

# analytics-service
ANALYTICS_SERVICE_PORT=
# social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/oauth/kakao/callback

# mail
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@findy.local
