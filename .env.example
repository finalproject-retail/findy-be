# docker-compose.yml 과 동일한 값으로 .env 파일을 만드세요.
# 로컬 IDE 실행 시에는 DB_HOST=localhost, REDIS_HOST=localhost 로 두면 됩니다.
# Docker Compose 실행 시 컨테이너 내부 호스트명(postgres, redis)은 compose가 자동 설정합니다.

# PostgreSQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Redis
REDIS_HOST=
REDIS_PORT=

# user-service
JWT_SECRET_KEY=
USER_SERVICE_PORT=

# apigateway
APIGATEWAY_PORT=
CORS_ALLOWED_ORIGINS=

# shopping-service (application.yaml server.port=8887)
SHOPPING_SERVICE_PORT=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
MFDS_API_KEY=
HACCP_SERVICE_KEY=

# map-service (application.yaml server.port=8888)
MAP_SERVICE_PORT=

# recommendation-service
RECOMMENDATION_SERVICE_PORT=
OPENAI_API_KEY=

# analytics-service
ANALYTICS_SERVICE_PORT=